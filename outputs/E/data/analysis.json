        "Symbol": "g_HH",
        "Value": "+1.5",
        "Role": "2 g_HH = +3 per trade"
      },
      {
        "Parameter": "C-C one-sided payoff",
        "Symbol": "g_CC",
        "Value": "-2.0",
        "Role": "2 g_CC = -4 per trade"
      },
      {
        "Parameter": "H-C transfer",
        "Symbol": "x",
        "Value": "5.0",
        "Role": "Pure transfer, sum = 0"
      },
      {
        "Parameter": "Conversion threshold",
        "Symbol": "p",
        "Value": "2, 3, 4",
        "Role": "Victimisations before H becomes C"
      },
      {
        "Parameter": "Eviction threshold",
        "Symbol": "q",
        "Value": "3",
        "Role": "Reports before expulsion"
      },
      {
        "Parameter": "Survival cost",
        "Symbol": "c",
        "Value": "0 (main); 0.10, 0.30",
        "Role": "Per active agent per step"
      },
      {
        "Parameter": "Expulsion switch",
        "Symbol": "E",
        "Value": "0, 1",
        "Role": "Institutional treatment"
      },
      {
        "Parameter": "Bankruptcy",
        "Symbol": "w <= 0",
        "Value": "always on",
        "Role": "Wealth zeroed, agent exits"
      },
      {
        "Parameter": "Seeds per cell",
        "Symbol": "S",
        "Value": "30 (main), 20 (subsamples)",
        "Role": "Common random numbers"
      }
    ],
